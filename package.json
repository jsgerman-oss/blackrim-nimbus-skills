{
  "name": "blackrim-nimbus-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Tooling for the Blackrim.dev Nimbus cloud-toolkits marketplace — schema validation and regen scripts.",
  "type": "module",
  "scripts": {
    "check": "node bin/check-plugins",
    "regen:marketplace": "node bin/regen-marketplace",
    "regen:plugin-readmes": "node bin/regen-plugin-readmes",
    "regen": "npm run regen:marketplace && npm run regen:plugin-readmes",
    "rules": "node bin/list-rules",
    "checklist": "node bin/list-checklist",
    "test": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3"
  },
  "license": "MIT"
}
