#!/usr/bin/env bash
# nimbus CLI: scaffold + deploy a web app on a gas city (golden path + 19 clouds).
#
#   bin/nimbus version  [--json]
#   bin/nimbus info     [--json]
#
# (SCAFFOLD — the app-scaffold + deploy subcommands land in nim-rsa. The commands
# above only prove the wrapper -> python wiring and feed the smoke test.)
#
# This wrapper resolves the pack's own venv python (so nimbus runs under the
# interpreter its deps are installed in), falling back to system python3, then
# hands off to `python -m nimbus.cli`. It mirrors gascity-cockpit/bin/cockpit.
#
# Degrades gracefully: the engine is pure-stdlib, so it runs fine with no .venv as
# long as some python3 is present. If NO interpreter is found it prints a clear
# error to stderr and exits 2 — it never silently no-ops.
set -euo pipefail
PACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$PACK_DIR/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || true)"
[ -n "$PY" ] || { echo "nimbus: no python interpreter found (no .venv, no python3)" >&2; exit 2; }
exec env PYTHONPATH="$PACK_DIR${PYTHONPATH:+:$PYTHONPATH}" "$PY" -m nimbus.cli "$@"
